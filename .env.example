# ── Copy this file to .env and fill in your values ──
# DO NOT commit .env to Git

# Google Earth Engine Service Account email
GEE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com

# Path to service account JSON key (relative to project root)
# Put the actual file at this path, never commit it
GEE_KEY_FILE=service-account.json

# Backend server port
PORT=3001

# Frontend origin for CORS (Vite default)
FRONTEND_ORIGIN=http://localhost:5173
